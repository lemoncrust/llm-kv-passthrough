# Rate-based V1: one independent engine per service.
instance_id: {{ kvbench_instance_id | default(inventory_hostname) | to_json }}
server:
  host: 0.0.0.0
  port: 8000
  server_type: combined
  model_profile: {{ kvbench_model | default('llama-3.2-1b') | to_json }}
  workers: 1
  log_level: {{ kvbench_log_level | default('info') }}
gpu:
  gpu_profile: {{ kvbench_gpu | default('GB10') | to_json }}
  tp_size: {{ kvbench_tp_size | default(1) }}
timing:
  pp_size: {{ kvbench_pp_size | default(1) }}
scheduler:
  prefill_tokens_per_second: {{ kvbench_prefill_tps | default(10000) }}
  decode_tokens_per_second: {{ kvbench_decode_tps | default(1000) }}
  max_active_requests: {{ kvbench_max_active | default(16) }}
  max_pending_requests: {{ kvbench_max_pending | default(64) }}
kv:
  stack: lmcache
  lmcache_config_file: {{ ((kvbench_config_dir | default('/etc/kvbench')) + '/lmcache.yaml') | to_json }}
  max_cpu_memory_gb: {{ kvbench_cpu_pool_guard_gb | default(2) }}
metrics:
  enabled: {{ kvbench_metrics_enabled | default(true) | lower }}
  include_histograms: {{ kvbench_include_histograms | default(true) | lower }}
