[Unit]
Description=KV-Bench Server ({{ kvbench_instance_id | default(inventory_hostname) }})
Documentation=https://github.com/wvaske/llm-kv-passthrough
After=network.target

[Service]
Type=simple
User={{ kvbench_user | default('kvbench') }}
Group={{ kvbench_group | default('kvbench') }}
WorkingDirectory={{ kvbench_home | default('/opt/kvbench') }}

# Environment
Environment="PATH={{ kvbench_home | default('/opt/kvbench') }}/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="MALLOC_ARENA_MAX=2" "OMP_NUM_THREADS=1" "OPENBLAS_NUM_THREADS=1"
Environment="XDG_CACHE_HOME=/var/cache/kvbench"
CacheDirectory=kvbench
{% if kvbench_extra_env is defined %}
{% for key, value in kvbench_extra_env.items() %}
Environment="{{ key }}={{ value }}"
{% endfor %}
{% endif %}

# Command
ExecStart={{ kvbench_home | default('/opt/kvbench') }}/venv/bin/kvbench serve --config {{ kvbench_config_dir | default('/etc/kvbench') }}/config.yaml

# Restart policy
Restart=always
RestartSec=10
TimeoutStartSec=30
TimeoutStopSec=30

# Logging
StandardOutput=append:{{ kvbench_log_dir | default('/var/log/kvbench') }}/kvbench.log
StandardError=append:{{ kvbench_log_dir | default('/var/log/kvbench') }}/kvbench-error.log

# Resource limits
{% if kvbench_limit_nofile is defined %}
LimitNOFILE={{ kvbench_limit_nofile }}
{% else %}
LimitNOFILE=65535
{% endif %}
{% if kvbench_limit_nproc is defined %}
LimitNPROC={{ kvbench_limit_nproc }}
{% endif %}
MemoryMax={{ kvbench_memory_limit | default('2G') }}

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ kvbench_data_dir | default('/var/lib/kvbench') }} {{ kvbench_log_dir | default('/var/log/kvbench') }}
{% if lmcache_local_disk_path is defined %}
ReadWritePaths={{ lmcache_local_disk_path }}
{% endif %}

[Install]
WantedBy=multi-user.target
